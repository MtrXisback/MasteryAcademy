# ==========================================
# Database Credentials (PostgreSQL)
# ==========================================
DB_USER=cursos_admin
DB_PASSWORD=secret_db_password
DB_NAME=proyectocursos

# ==========================================
# PgAdmin Credentials
# ==========================================
PGADMIN_EMAIL=admin@cursos.com
PGADMIN_PASSWORD=secret_pgadmin_password

# ==========================================
# Security Settings
# ==========================================
JWT_SECRET=this_is_a_very_long_and_secure_jwt_secret_key_for_production
ADMIN_DEFAULT_PASSWORD=AdminStrongPass123!
ALLOWED_ORIGINS=http://localhost,http://localhost:4200

# ==========================================
# Third-Party Integrations
# ==========================================
# Culqi Payment Gateway
CULQI_PUBLIC_KEY=pk_test_example_key
CULQI_SECRET_KEY=sk_test_example_key

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth2
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
